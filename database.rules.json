{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "profile": {
          "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "email": { ".validate": "newData.isString() || newData.val() === null" },
          "photoURL": { ".validate": "newData.isString() || newData.val() === null" },
          "updatedAt": { ".validate": true },
          "$other": { ".validate": false }
        },

        "habits": {
          "$habitId": {
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "icon": { ".validate": "newData.isString() && newData.val().matches(/^(book|pencil|run|dumbbell|drop|moon)$/)" },
            "createdAt": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
            "order": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "completions": {
          "$day": {
            ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
            "$habitId": {
              ".validate": "newData.isBoolean() && newData.val() === true && root.child('users/' + $uid + '/habits/' + $habitId).exists()"
            }
          }
        },

        "fcmTokens": {
          "$token": {
            "createdAt": { ".validate": true },
            "ua": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "leaderboard": {
      ".read": "auth != null",
      ".indexOn": ["activeStreak", "bestStreak"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "photoURL": { ".validate": "newData.isString() || newData.val() === null" },
        "activeStreak": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "bestStreak": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "updatedAt": { ".validate": true },
        "$other": { ".validate": false }
      }
    }
  }
}
