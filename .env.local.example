# Firebase Web App config
# Console > Project Settings > General > Your apps > Web app (</>)
# Yeh saari values public hain (browser me bhejhi jaati hain) - secret nahi.
# Aapka data security Database Rules se protect hota hai, in keys se nahi.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=arise-699d5.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=arise-699d5
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=arise-699d5.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Realtime Database URL - Console > Realtime Database > apne instance ke upar
# default (us-central1): https://arise-699d5-default-rtdb.firebaseio.com
# asia-southeast1:       https://arise-699d5-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Web Push certificate (VAPID key) - Console > Project Settings > Cloud Messaging
# > Web configuration > Web Push certificates > Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- SERVER ONLY, kabhi commit mat karna ---
# Service account JSON ka absolute path (FCM bhejne ke liye).
# Repo ke bahar rakho, jaise C:\secrets\arise-admin.json
FIREBASE_SERVICE_ACCOUNT_PATH=
